@{
    ViewData["Title"] = "Entrenar animado - Perceptrón 3x1";
}

<link rel="stylesheet" href="~/css/perceptron.css" asp-append-version="true" />

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>2) Entrenar animado: intentar → equivocarse → ajustar</h2>
    <div class="btn-group">
        <a class="btn btn-outline-secondary" asp-action="Index">Inicio</a>
        <a class="btn btn-outline-primary" asp-action="Entender">Entender</a>
        <a class="btn btn-outline-success" asp-action="Jugar">Jugar</a>
    </div>
</div>

<p class="text-muted">Vamos a mostrar <strong>un ejemplo a la vez</strong>, como haría el bucle. Pequeños ajustes acumulados giran las perillas.</p>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card perceptron-card">
            <div class="card-header d-flex justify-content-between">
                <span>Ejemplos (playa.py)</span>
                <span>Época: <strong id="epoch">0</strong> / 10 (demo)</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm mb-0 train-table">
                        <thead>
                            <tr><th>sol</th><th>calor</th><th>finde</th><th>Esperado</th><th>Estado</th></tr>
                        </thead>
                        <tbody id="trainTableBody"></tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="card perceptron-card mt-3">
            <div class="card-header">Controles</div>
            <div class="card-body d-flex flex-wrap gap-2 align-items-center">
                <button class="btn btn-primary" id="btnStart">Iniciar</button>
                <button class="btn btn-outline-secondary" id="btnStep">Paso a paso</button>
                <button class="btn btn-outline-warning" id="btnReset">Reiniciar</button>
                <div class="ms-auto d-flex align-items-center gap-2">
                    <span class="text-muted">Velocidad</span>
                    <select id="speed" class="form-select form-select-sm" style="width:auto">
                        <option value="900">Lento</option>
                        <option value="400" selected>Normal</option>
                        <option value="150">Rápido</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card perceptron-card">
            <div class="card-header">Intento actual</div>
            <div class="card-body">
                <div class="current-case">
                    Entrada: [<span id="cx1">?</span>, <span id="cx2">?</span>, <span id="cx3">?</span>] → Esperado: <strong id="cy">?</strong>
                </div>
                <div class="pred-vs mt-2">
                    <div>Yo digo: <span id="predProb">0.5000</span> (<span id="predLabel">?</span>)</div>
                    <div>Debería ser: <strong id="trueLabel">?</strong></div>
                </div>
                <div class="error mt-2">Error (Loss aprox.): <span id="lossCur">-</span></div>
                <div class="hint mt-2" id="trainHint">Presioná "Paso a paso" o "Iniciar" para ver el ciclo.</div>
            </div>
        </div>

        <div class="card perceptron-card mt-3">
            <div class="card-header">Las perillas (se ajustan)</div>
            <div class="card-body">
                <div class="knob-row"><span>w1</span><div class="knob-bar"><div class="knob-fill" id="k1"></div></div><span id="kw1">0.0000</span></div>
                <div class="knob-row"><span>w2</span><div class="knob-bar"><div class="knob-fill" id="k2"></div></div><span id="kw2">0.0000</span></div>
                <div class="knob-row"><span>w3</span><div class="knob-bar"><div class="knob-fill" id="k3"></div></div><span id="kw3">0.0000</span></div>
                <div class="knob-row"><span>b</span><div class="knob-bar"><div class="knob-fill bias" id="kb"></div></div><span id="kbias">0.0000</span></div>
                <div class="text-muted mt-2">Iniciales aleatorios → van hacia [7.0982, 7.0982, 7.0982], [-10.4991]</div>
            </div>
        </div>
    </div>

    <div class="col-lg-3">
        <div class="card perceptron-card h-100">
            <div class="card-header">Pérdida</div>
            <div class="card-body">
                <div class="loss-graph">
                    <svg viewBox="0 0 200 100" preserveAspectRatio="none">
                        <polyline id="lossLine" points="0,80" fill="none" stroke="#0d6efd" stroke-width="2" />
                    </svg>
                </div>
                <div class="d-flex justify-content-between text-muted mt-2"><span>Inicio</span><span>Después</span></div>
                <div class="hint mt-3">El <code>loss</code> baja porque giramos las perillas para equivocarnos menos.</div>
                <div class="llm-mini mt-4">
                    <div class="llm-mini-title">Conexión con LLMs</div>
                    <div class="llm-mini-text">Acá 4 perillas. Ahí miles de millones. Mismo ciclo: intentar → equivocarse → ajustar.</div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/perceptron-train.js"></script>
}
