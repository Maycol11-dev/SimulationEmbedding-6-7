@{
    ViewData["Title"] = "Entrenamiento animado - Perceptrón 3x1";
}

@section Head {
    <link rel="stylesheet" href="~/css/neural-dark.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/perceptron.css" asp-append-version="true" />
}

<div class="page-full">
    <header class="page-header">
        <span class="page-kicker">Perceptrón 3x1</span>
        <h1 class="page-title">Entrenamiento animado</h1>
        <p class="page-subtitle">Intentar → equivocarse → ajustar, un ejemplo a la vez</p>
        <div class="actions-row">
            <a class="btn-ghost-neo text-decoration-none" asp-action="Index">Inicio</a>
            <a class="btn-ghost-neo text-decoration-none" asp-action="Neural">Recorrido unificado</a>
            <a class="btn-ghost-neo text-decoration-none" asp-action="Jugar">Probar</a>
            <a class="btn-ghost-neo text-decoration-none" asp-action="TikTok">TikTok Simulator</a>
        </div>
    </header>

    <div class="layout-grid">
        <section class="panel">
            <header class="panel-header">
                <div class="panel-title-group">
                    <span class="panel-kicker">Proceso</span>
                    <h2 class="panel-title">Ciclo de aprendizaje</h2>
                    <span class="panel-subtitle">Época: <span class="data-mono" id="epoch">0</span> / 10 (demo)</span>
                </div>
            </header>
            <div class="panel-body">
                <div class="data-panel" style="background: transparent;">
                    <div class="data-body" style="padding: 0;">
                        <div class="table-responsive">
                            <table class="table table-sm mb-0 train-table" style="color: var(--text);">
                                <thead>
                                    <tr>
                                        <th>sol</th>
                                        <th>calor</th>
                                        <th>finde</th>
                                        <th>Esperado</th>
                                        <th>Estado</th>
                                    </tr>
                                </thead>
                                <tbody id="trainTableBody"></tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="actions-row">
                    <button class="btn-neo" id="btnStart">Iniciar</button>
                    <button class="btn-ghost-neo" id="btnStep">Paso a paso</button>
                    <button class="btn-ghost-neo" id="btnReset">Reiniciar</button>
                    <select id="speed" class="btn-ghost-neo" style="background: transparent; color: var(--text);">
                        <option value="900">Lento</option>
                        <option value="400" selected>Normal</option>
                        <option value="150">Rápido</option>
                    </select>
                </div>
            </div>
        </section>

        <aside class="side-stack">
            <section class="data-panel">
                <header class="data-header">
                    <div class="data-title-group">
                        <span class="data-kicker">Intento actual</span>
                        <h3 class="data-title">Predicción vs Real</h3>
                    </div>
                </header>
                <div class="data-body">
                    <div class="narration-bar" style="align-self: stretch; border-radius: 12px; text-align: left;">
                        <span class="narration-text">Entrada: [<span id="cx1">?</span>, <span id="cx2">?</span>, <span id="cx3">?</span>] → Esperado: <strong id="cy">?</strong></span>
                    </div>
                    <div class="data-row"><div class="data-label"><span>Yo digo</span></div><span class="data-mono" id="predProb">0.5000</span><span id="predLabel">?</span></div>
                    <div class="data-row"><div class="data-label"><span>Debería ser</span></div><span class="data-sub">Correcto</span><span id="trueLabel">?</span></div>
                    <div class="data-row"><div class="data-label"><span>Error</span></div><span class="data-mono" id="lossCur">-</span></div>
                    <div class="narration-text" id="trainHint">Presioná "Paso a paso" o "Iniciar" para ver el ciclo.</div>
                </div>
            </section>

            <section class="data-panel">
                <header class="data-header">
                    <div class="data-title-group">
                        <span class="data-kicker">Perillas</span>
                        <h3 class="data-title">Se ajustan en tiempo real</h3>
                    </div>
                </header>
                <div class="data-body">
                    <div class="meter"><span class="data-mono">w1</span><div class="meter-track"><div class="meter-fill" id="k1"></div></div><span class="data-mono" id="kw1">0.0000</span></div>
                    <div class="meter"><span class="data-mono">w2</span><div class="meter-track"><div class="meter-fill" id="k2"></div></div><span class="data-mono" id="kw2">0.0000</span></div>
                    <div class="meter"><span class="data-mono">w3</span><div class="meter-track"><div class="meter-fill" id="k3"></div></div><span class="data-mono" id="kw3">0.0000</span></div>
                    <div class="meter"><span class="data-mono">b</span><div class="meter-track"><div class="meter-fill bias" id="kb"></div></div><span class="data-mono" id="kbias">0.0000</span></div>
                </div>
            </section>

            <section class="data-panel">
                <header class="data-header">
                    <div class="data-title-group">
                        <span class="data-kicker">Pérdida</span>
                        <h3 class="data-title">Curva</h3>
                    </div>
                </header>
                <div class="data-body">
                    <svg viewBox="0 0 200 100" preserveAspectRatio="none" style="width: 100%; height: 140px;">
                        <polyline id="lossLine" points="0,80" fill="none" stroke="var(--accent)" stroke-width="2" />
                    </svg>
                </div>
            </section>
        </aside>
    </div>
</div>

@section Scripts {
    <script src="~/js/perceptron-train.js"></script>
}
