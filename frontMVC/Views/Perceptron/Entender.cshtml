@{
    ViewData["Title"] = "Entender perceptrón";
}

@section Head {
    <link rel="stylesheet" href="~/css/neural-dark.css" asp-append-version="true" />
}

<div class="page-full">
    <header class="page-header">
        <span class="page-kicker">Perceptrón 3x1</span>
        <h1 class="page-title">Entender la mesa de perillas</h1>
        <p class="page-subtitle">Ver pesos, suma ponderada, sigmoid y decisión</p>
        <div class="actions-row">
            <a class="btn-ghost-neo text-decoration-none" asp-action="Index">Inicio</a>
            <a class="btn-ghost-neo text-decoration-none" asp-action="Neural">Recorrido unificado</a>
            <a class="btn-ghost-neo text-decoration-none" asp-action="Entrenar">Entrenamiento animado</a>
            <a class="btn-ghost-neo text-decoration-none" asp-action="TikTok">TikTok Simulator</a>
        </div>
    </header>

    <div class="layout-grid">
        <section class="panel">
            <header class="panel-header">
                <div class="panel-title-group">
                    <span class="panel-kicker">Red</span>
                    <h2 class="panel-title">3 entradas → 1 neurona</h2>
                </div>
            </header>
            <div class="panel-body">
                <div class="narration-bar">
                    <span class="narration-kicker">Fórmula</span>
                    <span class="narration-text">z = w1*x1 + w2*x2 + w3*x3 + b | p = sigmoid(z)</span>
                </div>
                <div class="data-row"><div class="data-label"><span>z</span></div><span class="data-mono" id="zVal">-10.4991</span></div>
                <div class="data-row"><div class="data-label"><span>p</span></div><span class="data-mono" id="pVal">0.0000</span></div>
                <div class="result-hero">
                    <span class="result-value" id="decText">NO</span>
                    <span class="narration-text" id="decSub">No alcanza el umbral</span>
                </div>
            </div>
        </section>

        <aside class="side-stack">
            <section class="data-panel">
                <header class="data-header">
                    <div class="data-title-group">
                        <span class="data-kicker">Entradas</span>
                        <h3 class="data-title">Condiciones</h3>
                    </div>
                </header>
                <div class="data-body">
                    <div class="input-item">
                        <div class="input-text"><span class="input-name">Sol</span><span class="input-meta">x1 = <span id="valSol">0</span></span></div>
                        <label class="switch"><input type="checkbox" id="chkSol"><span class="switch-slider"></span></label>
                    </div>
                    <div class="input-item">
                        <div class="input-text"><span class="input-name">Calor</span><span class="input-meta">x2 = <span id="valCalor">0</span></span></div>
                        <label class="switch"><input type="checkbox" id="chkCalor"><span class="switch-slider"></span></label>
                    </div>
                    <div class="input-item">
                        <div class="input-text"><span class="input-name">Fin de semana</span><span class="input-meta">x3 = <span id="valFinde">0</span></span></div>
                        <label class="switch"><input type="checkbox" id="chkFinde"><span class="switch-slider"></span></label>
                    </div>
                </div>
            </section>

            <section class="data-panel">
                <header class="data-header">
                    <div class="data-title-group">
                        <span class="data-kicker">Pesos</span>
                        <h3 class="data-title">Mesa de perillas</h3>
                    </div>
                </header>
                <div class="data-body">
                    <div class="data-row"><div class="data-label"><span>w1</span></div><span class="data-mono" id="w1">7.0982</span></div>
                    <div class="data-row"><div class="data-label"><span>w2</span></div><span class="data-mono" id="w2">7.0982</span></div>
                    <div class="data-row"><div class="data-label"><span>w3</span></div><span class="data-mono" id="w3">7.0982</span></div>
                    <div class="data-row"><div class="data-label"><span>b</span></div><span class="data-mono" id="b">-10.4991</span></div>
                </div>
            </section>
        </aside>
    </div>
</div>

@section Scripts {
    <script src="~/js/perceptron.js"></script>
    <script>window.PERCEPTRON_WEIGHTS = {w1:7.0982,w2:7.0982,w3:7.0982,b:-10.4991};</script>
}
