@{
    ViewData["Title"] = "Cerebro Digital";
}

@section Head {
    <link rel="stylesheet" href="~/css/neural-dark.css" asp-append-version="true" />
    <style>
        .split-hero {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
            margin-top: 1.5rem;
        }
        @@media (max-width: 1100px) {
            .split-hero { grid-template-columns: 1fr; }
        }
        .step-card {
            border-radius: 18px;
            padding: 1.75rem;
            background: radial-gradient(800px 300px at 50% 0%, rgba(255,255,255,0.03) 0%, transparent 70%), var(--panel);
            border: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            gap: 1rem;
            position: relative;
            overflow: hidden;
        }
        .step-card.cyan { border-color: rgba(34, 211, 238, 0.55); box-shadow: 0 0 40px rgba(34, 211, 238, 0.08); }
        .step-card.violet { border-color: rgba(217, 70, 239, 0.55); box-shadow: 0 0 40px rgba(217, 70, 239, 0.1); }
        .step-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            font-size: 0.7rem;
            letter-spacing: 0.3em;
            text-transform: uppercase;
            color: var(--sub);
        }
        .step-badge.live {
            color: #f0abfc;
            border: 1px solid rgba(217, 70, 239, 0.5);
            padding: 0.2rem 0.6rem;
            border-radius: 999px;
            background: rgba(217, 70, 239, 0.12);
        }
        .step-title {
            font-size: 1.6rem;
            font-weight: 700;
            margin: 0;
            color: #fff;
        }
        .step-points {
            margin: 0;
            padding-left: 1.1rem;
            color: #a0aec0;
            line-height: 1.7;
            font-size: 0.95rem;
        }
        .step-points li { margin: 0.25rem 0; }
        .step-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 0.5rem; }
        .scale-bar {
            margin-top: 2rem;
            border-radius: 16px;
            border: 1px solid var(--border);
            background: var(--panel);
            padding: 1.2rem 1.5rem;
        }
        .scale-title {
            text-transform: uppercase;
            letter-spacing: 0.35em;
            font-size: 0.7rem;
            color: var(--sub);
            margin-bottom: 0.8rem;
        }
        .scale-items {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 0.75rem 1rem;
            font-family: "JetBrains Mono", monospace;
            font-size: 0.95rem;
        }
        .scale-item { color: #e7e9ee; }
        .scale-item span { color: var(--sub); font-size: 0.85rem; }
        .scale-arrow { color: var(--accent); font-size: 1.2rem; }
    </style>
}

<div class="page-full">
    <header class="page-header">
        <span class="page-kicker">Neural Fundamentals</span>
        <h1 class="page-title">Cerebro Digital: ¿Cómo aprende una Red Neuronal?</h1>
        <p class="page-subtitle">El mismo mecanismo matemático de 4 perillas que decide si vas a la playa es el que mueve al algoritmo de TikTok y a ChatGPT</p>
    </header>

    <div class="split-hero">
        <section class="step-card cyan">
            <div class="step-badge">Paso 1 · El Átomo · Didáctico</div>
            <h2 class="step-title">Perceptrón 3×1 (Fundamentos)</h2>
            <ul class="step-points">
                <li>3 entradas: Sol, Calor, Fin de semana</li>
                <li>1 neurona y 4 perillas totales (3 pesos + 1 bias)</li>
                <li>Regla aprendida: "Al menos 2 de 3"</li>
            </ul>
            <div class="step-actions">
                <a class="btn-neo text-decoration-none" asp-controller="Perceptron" asp-action="Neural">Recorrido Unificado</a>
                <a class="btn-ghost-neo text-decoration-none" asp-controller="Perceptron" asp-action="Entrenar">Entrenamiento Animado</a>
                <a class="btn-ghost-neo text-decoration-none" asp-controller="Perceptron" asp-action="Entender">Entender/Probar</a>
            </div>
        </section>

        <section class="step-card violet">
            <div class="d-flex justify-content-between align-items-start">
                <div class="step-badge">Paso 2 · La Escala Real · Algoritmo TikTok</div>
                <span class="step-badge live">EN VIVO</span>
            </div>
            <h2 class="step-title">Algoritmo de Recomendación de TikTok</h2>
            <ul class="step-points">
                <li>25 señales reales de comportamiento</li>
                <li>Capa oculta interactiva y grafo con flujo sináptico animado</li>
                <li>3 salidas probabilísticas: retención, skip e interacción</li>
            </ul>
            <div class="step-actions">
                <a class="btn-neo text-decoration-none" asp-controller="Perceptron" asp-action="TikTok">Abrir Simulador Interactivo ⚡</a>
            </div>
        </section>
    </div>

    <div class="scale-bar">
        <div class="scale-title">Escala comparativa</div>
        <div class="scale-items">
            <div class="scale-item">Perceptrón <span>(4 parámetros)</span></div>
            <div class="scale-arrow">→</div>
            <div class="scale-item">TikTok <span>(~250 parámetros)</span></div>
            <div class="scale-arrow">→</div>
            <div class="scale-item">ChatGPT <span>(1.8 Billones de parámetros)</span></div>
        </div>
    </div>
</div>
