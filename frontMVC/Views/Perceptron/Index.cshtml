@{
    ViewData["Title"] = "Simuladores Neuronales";
}

@section Head {
    <link rel="stylesheet" href="~/css/neural-dark.css" asp-append-version="true" />
}

<div class="page-full">
    <header class="page-header">
        <span class="page-kicker">Neural Simulators</span>
        <h1 class="page-title">Simuladores de Redes Neuronales</h1>
        <p class="page-subtitle">Desde el perceptrón más simple hasta un simulador de recomendación inspirado en TikTok.</p>
    </header>

    <div class="layout-grid">
        <section class="panel">
            <header class="panel-header">
                <div class="panel-title-group">
                    <span class="panel-kicker">Fundamentos</span>
                    <h2 class="panel-title">Perceptrón 3x1</h2>
                    <span class="panel-subtitle">Aprende ajustando pesos y bias</span>
                </div>
            </header>
            <div class="panel-body">
                <div class="narration-bar">
                    <span class="narration-kicker">Objetivo</span>
                    <span class="narration-text">Ver el ciclo intentar → equivocarse → ajustar hasta descubrir "al menos 2 de 3"</span>
                </div>
                <div class="actions-row">
                    <a class="btn-neo text-decoration-none" asp-controller="Perceptron" asp-action="Neural">Recorrido unificado</a>
                    <a class="btn-ghost-neo text-decoration-none" asp-controller="Perceptron" asp-action="Entrenar">Entrenamiento animado</a>
                    <a class="btn-ghost-neo text-decoration-none" asp-controller="Perceptron" asp-action="Entender">Entender / Probar</a>
                </div>
            </div>
        </section>

        <aside class="side-stack">
            <section class="data-panel">
                <header class="data-header">
                    <div class="data-title-group">
                        <span class="data-kicker">Avanzado</span>
                        <h3 class="data-title">Algoritmo de Recomendación TikTok</h3>
                    </div>
                </header>
                <div class="data-body">
                    <div class="narration-bar" style="align-self: stretch; text-align: left; border-radius: 14px;">
                        <span class="narration-kicker">Arquitectura</span>
                        <span class="narration-text">25 entradas → X neuronas (4-12) → 3 salidas. Interacciones, contenido, contexto e historial.</span>
                    </div>
                    <div class="actions-row">
                        <a class="btn-neo text-decoration-none" asp-controller="Perceptron" asp-action="TikTok">Abrir simulador</a>
                    </div>
                </div>
            </section>

            <section class="data-panel">
                <header class="data-header">
                    <div class="data-title-group">
                        <span class="data-kicker">Conexión</span>
                        <h3 class="data-title">Escala</h3>
                    </div>
                </header>
                <div class="data-body">
                    <div class="data-row"><div class="data-label"><span>Perceptrón</span></div><span class="data-sub">4 perillas</span><span>Didáctico</span></div>
                    <div class="data-row"><div class="data-label"><span>MLP</span></div><span class="data-sub">Capas ocultas</span><span>Representaciones</span></div>
                    <div class="data-row"><div class="data-label"><span>LLMs</span></div><span class="data-sub">Miles de millones</span><span>Mismo principio</span></div>
                </div>
            </section>
        </aside>
    </div>
</div>
