@{
    ViewData["Title"] = "Simuladores Neuronales";
}

@section Head {
    <link rel="stylesheet" href="~/css/neural-dark.css" asp-append-version="true" />
}

<div class="page-full">
    <header class="page-header">
        <span class="page-kicker">Neural Simulators</span>
        <h1 class="page-title">Simuladores de Redes Neuronales</h1>
        <p class="page-subtitle">Desde el perceptrón más elemental de 3 entradas hasta una red multicapa completa de 25 entradas con API .NET y persistencia de pesos en SQLite.</p>
    </header>

    <!-- Tarjeta Principal Destacada: Red Multicapa de 25 Entradas -->
    <div style="background: linear-gradient(135deg, rgba(0, 210, 255, 0.12) 0%, rgba(157, 78, 221, 0.12) 100%); border: 1px solid rgba(0, 210, 255, 0.4); border-radius: 16px; padding: 2rem; margin-bottom: 2rem;">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <div>
                <span class="badge text-bg-info mb-1 font-mono" style="font-size: 0.75rem;">NUEVO PROYECTO PRINCIPAL</span>
                <h2 style="font-size: 1.8rem; font-weight: 800; margin: 0; color: #fff;">
                    🎯 Red Neuronal Multicapa: "¿Qué actividad hacer hoy?"
                </h2>
                <span style="color: #8b9bb4; font-size: 0.95rem;">25 Entradas (Clima, Estado, Finanzas, Social, Gustos) → X Neuronas Ocultas (ReLU) → 5 Salidas (Softmax)</span>
            </div>
            <div class="d-flex gap-2">
                <a class="btn-neo text-decoration-none" asp-controller="Actividad" asp-action="Probar">Probar Simulador en Vivo ⚡</a>
            </div>
        </div>

        <p style="color: #a0aec0; font-size: 0.95rem; max-width: 900px; line-height: 1.6; margin-bottom: 1.5rem;">
            Sistema completo conectado con <strong>API .NET 10</strong> y base de datos relacional <strong>SQLite</strong>. 
            Cualquier persona puede entender paso a paso cómo cada perilla (peso) altera las probabilidades, cómo aprende por backpropagation y cómo se guardan y activan las sesiones de entrenamiento en la base de datos.
        </p>

        <div class="actions-row">
            <a class="btn-neo text-decoration-none" asp-controller="Actividad" asp-action="Probar">🕹️ Simulador en Vivo (25 Sliders)</a>
            <a class="btn-ghost-neo text-decoration-none" asp-controller="Actividad" asp-action="Entrenar">⚡ Entrenar & BD SQLite</a>
            <a class="btn-ghost-neo text-decoration-none" asp-controller="Actividad" asp-action="Red">🕸️ Inspeccionar Red & Pesos</a>
            <a class="btn-ghost-neo text-decoration-none" asp-controller="Actividad" asp-action="Index">📖 Fundamentos Teóricos</a>
        </div>
    </div>

    <div class="layout-grid">
        <section class="panel">
            <header class="panel-header">
                <div class="panel-title-group">
                    <span class="panel-kicker">Fundamentos</span>
                    <h2 class="panel-title">Perceptrón 3x1</h2>
                    <span class="panel-subtitle">Aprende ajustando 3 pesos y 1 bias</span>
                </div>
            </header>
            <div class="panel-body">
                <div class="narration-bar">
                    <span class="narration-kicker">Objetivo</span>
                    <span class="narration-text">Ver el ciclo intentar → equivocarse → ajustar hasta descubrir "al menos 2 de 3" (¿Ir a la playa?)</span>
                </div>
                <div class="actions-row">
                    <a class="btn-neo text-decoration-none" asp-controller="Perceptron" asp-action="Neural">Recorrido unificado</a>
                    <a class="btn-ghost-neo text-decoration-none" asp-controller="Perceptron" asp-action="Entrenar">Entrenamiento animado</a>
                    <a class="btn-ghost-neo text-decoration-none" asp-controller="Perceptron" asp-action="Entender">Entender / Probar</a>
                </div>
            </div>
        </section>

        <aside class="side-stack">
            <section class="data-panel">
                <header class="data-header">
                    <div class="data-title-group">
                        <span class="data-kicker">Simulador Didáctico</span>
                        <h3 class="data-title">Recomendador TikTok</h3>
                    </div>
                </header>
                <div class="data-body">
                    <div class="narration-bar" style="align-self: stretch; text-align: left; border-radius: 14px;">
                        <span class="narration-kicker">Arquitectura</span>
                        <span class="narration-text">25 entradas → X neuronas (4-12) → 3 salidas (Retener, Skip, Interactuar).</span>
                    </div>
                    <div class="actions-row">
                        <a class="btn-neo text-decoration-none" asp-controller="Perceptron" asp-action="TikTok">Abrir simulador</a>
                    </div>
                </div>
            </section>

            <section class="data-panel">
                <header class="data-header">
                    <div class="data-title-group">
                        <span class="data-kicker">Conexión</span>
                        <h3 class="data-title">Escala</h3>
                    </div>
                </header>
                <div class="data-body">
                    <div class="data-row"><div class="data-label"><span>Perceptrón</span></div><span class="data-sub">4 perillas</span><span>playa.py</span></div>
                    <div class="data-row"><div class="data-label"><span>Multicapa 25xX</span></div><span class="data-sub">253 perillas</span><span>SQLite + API</span></div>
                    <div class="data-row"><div class="data-label"><span>CNN MNIST</span></div><span class="data-sub">210k perillas</span><span>train.py</span></div>
                    <div class="data-row"><div class="data-label"><span>LLMs</span></div><span class="data-sub">Miles de millones</span><span>ChatGPT</span></div>
                </div>
            </section>
        </aside>
    </div>
</div>
