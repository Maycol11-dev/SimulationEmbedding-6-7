@{
    ViewData["Title"] = "Jugar - Perceptrón 3x1";
}

<link rel="stylesheet" href="~/css/perceptron.css" asp-append-version="true" />

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>3) Jugar con los pesos ya aprendidos</h2>
    <div class="btn-group">
        <a class="btn btn-outline-secondary" asp-action="Index">Inicio</a>
        <a class="btn btn-outline-primary" asp-action="Entender">Entender</a>
        <a class="btn btn-primary" asp-action="Entrenar">Entrenar animado</a>
    </div>
</div>

<p class="text-muted">Usamos los pesos que aprendió la red al ejecutar <code>playa.py</code>: <strong>w = [7.0982, 7.0982, 7.0982], b = -10.4991</strong></p>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card perceptron-card">
            <div class="card-header">Configurá las condiciones</div>
            <div class="card-body">
                <div class="input-row">
                    <label class="toggle"><input type="checkbox" id="chkSol"><span class="slider"></span></label>
                    <div><div class="input-title">☀️ Sol</div><div class="input-sub">x1 = <span id="valSol">0</span></div></div>
                    <div class="weight-pill">w1 = <span id="w1">7.0982</span></div>
                </div>
                <div class="input-row">
                    <label class="toggle"><input type="checkbox" id="chkCalor"><span class="slider"></span></label>
                    <div><div class="input-title">🔥 Calor</div><div class="input-sub">x2 = <span id="valCalor">0</span></div></div>
                    <div class="weight-pill">w2 = <span id="w2">7.0982</span></div>
                </div>
                <div class="input-row">
                    <label class="toggle"><input type="checkbox" id="chkFinde"><span class="slider"></span></label>
                    <div><div class="input-title">🎉 Fin de semana</div><div class="input-sub">x3 = <span id="valFinde">0</span></div></div>
                    <div class="weight-pill">w3 = <span id="w3">7.0982</span></div>
                </div>
            </div>
        </div>
        <div class="card perceptron-card mt-3">
            <div class="card-header">Mesa de perillas (aprendida)</div>
            <div class="card-body">
                <div class="d-flex justify-content-between"><span>Importancia de cada entrada</span><span>Igual</span></div>
                <div class="d-flex justify-content-between mt-2"><span>Bias (exigencia)</span><span>b = -10.4991</span></div>
                <div class="hint mt-2">Necesita al menos <strong>2 de 3</strong> condiciones para alcanzar el umbral.</div>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card perceptron-card h-100">
            <div class="card-header">Cálculo en vivo</div>
            <div class="card-body">
                <div class="formula">z = w1*x1 + w2*x2 + w3*x3 + b</div>
                <div class="calc-line">z = <span id="term1">7.0982*0</span> + <span id="term2">7.0982*0</span> + <span id="term3">7.0982*0</span> + (<span id="termB">-10.4991</span>) = <strong id="zVal">-10.4991</strong></div>
                <div class="sigmoid-box">
                    <div class="sigmoid-title">Sigmoid (traductor)</div>
                    <div class="sigmoid-formula">p = 1 / (1 + e^(-z))</div>
                    <div class="sigmoid-result">p = <strong id="pVal">0.0000</strong></div>
                </div>
                <div class="prob-bar-wrap">
                    <div class="prob-labels"><span>0% (NO)</span><span>50%</span><span>100% (SI)</span></div>
                    <div class="prob-bar"><div class="prob-fill" id="probFill"></div><div class="prob-threshold"></div></div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-3">
        <div class="card perceptron-card h-100">
            <div class="card-header">Decisión</div>
            <div class="card-body text-center d-flex flex-column justify-content-center">
                <div class="decision-icon" id="decIcon">🏠</div>
                <div class="decision-text" id="decText">NO</div>
                <div class="decision-sub" id="decSub">Muy poca confianza. No alcanza el umbral (&lt; 0.5)</div>
                <div class="hint mt-3">Con al menos 2 de 3 condiciones activas, los pesos iguales alcanzan el umbral.</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/perceptron.js"></script>
    <script>
        window.PERCEPTRON_WEIGHTS = {w1:7.0982,w2:7.0982,w3:7.0982,b:-10.4991};
    </script>
}
